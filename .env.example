# Copia este archivo como .env junto a docker-compose.yml y rellena los valores.
# El .env real solo existe en la máquina virtual; nunca se sube al repositorio.

# Dominio público. Caddy pide el certificado HTTPS para este nombre.
SITE_ADDRESS=habitsquad.example.cloudapp.azure.com

# Genera la clave con:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=habitsquad.example.cloudapp.azure.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://habitsquad.example.cloudapp.azure.com

POSTGRES_DB=habitsquad
POSTGRES_USER=habitsquad
POSTGRES_PASSWORD=
