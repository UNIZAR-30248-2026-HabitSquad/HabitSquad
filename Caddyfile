{$SITE_ADDRESS} {
	encode zstd gzip

	@django path /api /api/* /admin /admin/*
	handle @django {
		reverse_proxy api:8000
	}

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		root * /srv/frontend

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		@shell path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
